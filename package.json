{
  "name": "react-boilerplate",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "api:sync": "orval",
    "typecheck": "react-router typegen && tsc",
    "knip": "knip",
    "staticchecks": "bun run lint && bun run typecheck && bun run knip && bun run test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@react-router/node": "^8.4.0",
    "@react-router/serve": "^8.4.0",
    "@tanstack/react-query": "^5.104.0",
    "isbot": "^5.1.36",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@eslint/js": "^9.39.0",
    "@eslint/json": "^2.1.0",
    "@react-router/dev": "^8.4.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^26.6.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^9.39.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-storybook": "^10.6.1",
    "globals": "^17.12.0",
    "knip": "^6.38.0",
    "orval": "^8.38.0",
    "prettier": "3.9.9",
    "pretty-quick": "^4.2.2",
    "simple-git-hooks": "^2.14.0",
    "storybook": "^10.6.1",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.0.3",
    "vitest": "^5.0.2"
  }
}
